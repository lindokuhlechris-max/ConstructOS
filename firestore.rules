rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /app_state/main {
      allow read: if request.auth != null && (request.auth.token.email == 'Lindokuhlechris@gmail.com' || (exists(/databases/$(database)/documents/permissions/$(request.auth.token.email)) && get(/databases/$(database)/documents/permissions/$(request.auth.token.email)).data.role in ['admin', 'write', 'view']));
      allow write: if request.auth != null && (request.auth.token.email == 'Lindokuhlechris@gmail.com' || (exists(/databases/$(database)/documents/permissions/$(request.auth.token.email)) && get(/databases/$(database)/documents/permissions/$(request.auth.token.email)).data.role in ['admin', 'write']));
    }
    match /permissions/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.email == 'Lindokuhlechris@gmail.com' || (exists(/databases/$(database)/documents/permissions/$(request.auth.token.email)) && get(/databases/$(database)/documents/permissions/$(request.auth.token.email)).data.role == 'admin'));
    }
  }
}
